NODE_ENV=development
PORT=3000
DATABASE_URL=sqlite://./leetkob.db
SANDBOX_DOCKER_IMAGE=leetkob-sandbox:latest
# Docker socket group ID (use the host socket GID on Linux).
DOCKER_GID=0
# Model provider and model configuration
MODEL_PROVIDER=deploy
DEPLOY_API_KEY=your_deploy_api_key_here
DEPLOY_API_URL=https://api-cdn.deploy.com/api/v1/chat/completions
MODEL_NAME=deepseek-ai/deepseek-v4.1-flash-1017
# Alternative / fallback provider:
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-3.5-flash-lite
# MODEL_API_KEY=your_gemini_api_key_here
MODEL_SPENDING_CAP_USD=5.00
# Offline model switch (0: enabled/online, 1: disabled/offline without network for evaluation)
MODEL_OFF=0
# Optional pricing overrides per 1M tokens (defaults to Gemini 1.5 Flash rates: $0.075 / $0.300)
MODEL_PROMPT_PRICE_PER_M=0.075
MODEL_COMPLETION_PRICE_PER_M=0.30
